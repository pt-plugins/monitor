---
interface Props {
  siteId: string;
  builtCount: number;
}

const { siteId, builtCount } = Astro.props;
---

<p class="more-link">
  <button type="button" id="history-open" class="btn btn--ghost" aria-haspopup="dialog">
    <span id="history-open-label">Load Extended History</span>
    <span id="history-open-badge" class="more-badge" hidden></span>
  </button>
</p>

<!-- Extended History (browser-side, cached locally). Kept in a dialog so the
     page stays scannable; the loader anchor lives inside it. -->
<dialog id="history-dialog" class="history-dialog" aria-labelledby="history-dialog-title">
  <div class="history-panel" id="history-loader" data-site-id={siteId} data-built-count={builtCount}>
    <div class="history-dialog-head">
      <h2 id="history-dialog-title">Extended History</h2>
      <button type="button" id="history-close" class="btn btn--ghost" aria-label="Close">Close</button>
    </div>
    <div class="history-controls">
      <label class="field">
        <span class="field-label">Range</span>
        <select id="history-months" class="field-input">
          <option value="3">Last 3 months</option>
          <option value="6" selected>Last 6 months</option>
          <option value="12">Last 12 months</option>
          <option value="all">All history</option>
        </select>
      </label>
      <label class="field field--wide">
        <span class="field-label">GitHub token (optional, saved locally)</span>
        <input
          type="password"
          id="history-token"
          class="field-input"
          placeholder="ghp_… / github_pat_…"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <div class="history-actions">
        <button type="button" id="history-load" class="btn btn--primary">Load history</button>
        <button type="button" id="history-clear" class="btn" disabled>Clear cache</button>
      </div>
    </div>

    {/* Keep this paragraph on a single line: Astro trims whitespace at a line
        break that sits next to an inline tag, which jams the words together
        (e.g. "from" + the data/uptime link). */}
    <p class="history-note">
      Fetches merged daily/monthly JSONL files from <a href="https://github.com/pt-plugins/monitor/tree/main/data/uptime" target="_blank" rel="noopener">data/uptime</a> through the GitHub REST API and caches each file with the Cache API. Fetched records are merged into the <strong>Checks History</strong> list on this page, deduplicated by timestamp — close this dialog to read them. Merged rows are marked <strong>Fetched</strong> in the Source column so they are never mistaken for the records the build embedded; the page's own rows read <strong>Built</strong>. The optional token is stored in this browser and raises the API rate limit from 60 to 5000 requests per hour. History starts at 2026-06, the earliest month with merged data. <a href="https://github.com/pt-plugins/monitor/tree/main/data/uptime/" target="_blank" rel="noopener">View full history on GitHub →</a>
    </p>

    <p id="history-status" class="history-status" data-kind="idle" aria-live="polite"></p>
    <div id="history-progress" class="history-progress" hidden>
      <div class="history-progress-bar"><span id="history-progress-fill"></span></div>
      <p id="history-progress-text" class="history-progress-text"></p>
    </div>
    <p id="history-summary" class="history-summary"></p>
  </div>
</dialog>

<script>
  import {
    CACHE_NAME,
    HISTORY_DATA_DIR,
    LEGACY_CACHE_PREFIX,
    TOKEN_STORAGE_KEY,
    contentsApiUrl,
    dailyFilePath,
    formatCheckTime,
    isWithinHistoryRange,
    monthlyFilePath,
    parseJsonlForSite,
    type HistoryEntry,
  } from "../lib/history-fetch";

  (function () {
    const root = document.getElementById("history-loader");
    if (!root) return;

    const siteId = root.dataset.siteId || "";
    const builtCount = Number(root.dataset.builtCount || "0") || 0;
    if (!siteId) return;

    const statusEl = document.getElementById("history-status");
    const loadBtn = document.getElementById("history-load") as HTMLButtonElement | null;
    const clearBtn = document.getElementById("history-clear") as HTMLButtonElement | null;
    const tokenInput = document.getElementById("history-token") as HTMLInputElement | null;
    const monthsInput = document.getElementById("history-months") as HTMLSelectElement | null;

    const summaryEl = document.getElementById("history-summary");

    const dialogEl = document.getElementById("history-dialog") as HTMLDialogElement | null;
    const openBtn = document.getElementById("history-open") as HTMLButtonElement | null;
    const openLabel = document.getElementById("history-open-label");
    const openBadge = document.getElementById("history-open-badge");
    const closeBtn = document.getElementById("history-close") as HTMLButtonElement | null;
    const progressEl = document.getElementById("history-progress");
    const progressFill = document.getElementById("history-progress-fill");
    const progressText = document.getElementById("history-progress-text");

    const STATUS_TEXT: Record<string, string> = {
      idle: "",
      loading: "Fetching history…",
      done: "History loaded.",
      empty: "No additional history found in the selected range.",
      error: "Failed to load history.",
    };

    function setStatus(kind: string, detail?: string) {
      if (!statusEl) return;
      const base = STATUS_TEXT[kind] || "";
      statusEl.textContent = detail ? `${base} ${detail}` : base;
      statusEl.dataset.kind = kind;
    }

    /**
     * Reflect what has been merged on the trigger that lives outside the dialog,
     * so the result stays readable after the dialog closes — the page's Checks
     * History table gains rows at the top, far from the button that loaded them.
     */
    function updateTrigger(added: number) {
      if (openLabel) {
        openLabel.textContent = added > 0 ? "Update Extended History" : "Extended History";
      }
      if (openBadge) {
        openBadge.hidden = added === 0;
        openBadge.textContent = added > 0 ? `+${added}` : "";
      }
      if (openBtn) {
        openBtn.dataset.state = added > 0 ? "merged" : "idle";
        openBtn.title =
          added > 0
            ? `${added} fetched records merged into Checks History on this page.`
            : "No fetched records merged into Checks History yet.";
      }
    }

    function fmtTime(iso: string): string {
      // Shared with the build-time page: formatting in the visitor's own zone
      // made merged rows disagree with the built-in ones by the UTC offset.
      return formatCheckTime(iso);
    }

    function fmtLatency(ms: number | null): string {
      if (ms === null) return "—";
      return ms < 1000 ? `${ms}ms` : `${(ms / 1000).toFixed(1)}s`;
    }

    // Mirrors StatusBadge.astro so fetched rows are visually identical to the
    // server-rendered ones rather than a separate pill style.
    const BADGE_LABELS: Record<string, string> = {
      up: "UP",
      down: "DOWN",
      dead: "DEAD",
    };

    function createBadge(status: string): HTMLSpanElement {
      const badge = document.createElement("span");
      badge.className = `badge badge--${status} badge--sm`;

      const dot = document.createElement("span");
      dot.className = "badge-dot";
      dot.setAttribute("aria-hidden", "true");
      badge.appendChild(dot);

      badge.appendChild(document.createTextNode(BADGE_LABELS[status] ?? status.toUpperCase()));
      return badge;
    }

    // ---- Cache API storage -------------------------------------------------
    // Payloads live in the Cache API; only the token and small UI preferences
    // use localStorage. The Cache API is unavailable on insecure origins, in
    // which case caching silently degrades to "always fetch".
    const cacheStorageAvailable = typeof caches !== "undefined";

    /**
     * A cached file holds the raw JSONL body exactly as the API returned it,
     * unfiltered. Filtering to the current site happens after the read, so one
     * cache entry serves every site that shares the file — keying on a filtered
     * payload is what previously let one site render another site's rows.
     *
     * The body is read through a clone: a Response body can only be consumed
     * once, and `cache.match()` hands back the stored object itself, so reading
     * it directly would leave the entry unusable and make every later read look
     * like a miss.
     */
    async function cacheGetText(path: string): Promise<string | null> {
      if (!cacheStorageAvailable) return null;
      try {
        const cache = await caches.open(CACHE_NAME);
        const hit = await cache.match(contentsApiUrl(path));
        if (!hit) return null;
        return await hit.clone().text();
      } catch {
        return null;
      }
    }

    async function cacheSetText(path: string, text: string) {
      if (!cacheStorageAvailable) return;
      try {
        const cache = await caches.open(CACHE_NAME);
        await cache.put(
          contentsApiUrl(path),
          new Response(text, {
            headers: { "Content-Type": "application/vnd.github.v3.raw" },
          }),
        );
      } catch {
        // Quota exceeded or storage disabled — fetching still works.
      }
    }

    /**
     * Remove cache buckets written by earlier versions. Their entries stored a
     * payload already filtered to one site under a site-specific key, which is
     * incompatible with the raw-body format above.
     */
    async function dropLegacyCaches() {
      if (!cacheStorageAvailable) return;
      try {
        const names = await caches.keys();
        await Promise.all(names.filter((n) => n.startsWith(LEGACY_CACHE_PREFIX)).map((n) => caches.delete(n)));
      } catch {
        // Nothing to clean up, or storage is unavailable.
      }
    }

    /** Data paths currently present in the cache bucket. */
    async function cachedPaths(): Promise<string[]> {
      if (!cacheStorageAvailable) return [];
      try {
        const cache = await caches.open(CACHE_NAME);
        const keys = await cache.keys();
        // Derive the prefix from a real data key so no trailing-slash guess is
        // involved: contentsApiUrl("") would end in "/contents/?ref=…".
        const marker = "/contents/";
        return keys
          .map((k) => k.url)
          .map((u) => {
            const i = u.indexOf(marker);
            if (i === -1) return null;
            const rest = u.slice(i + marker.length);
            const q = rest.indexOf("?");
            const path = q === -1 ? rest : rest.slice(0, q);
            return path.startsWith("data/uptime/") ? path : null;
          })
          .filter((p): p is string => p !== null);
      } catch {
        return [];
      }
    }

    /**
     * Drop cached daily files for any month whose monthly file is now present.
     * cleanup.mjs deletes the daily files upstream after merging them, so the
     * monthly file is the authoritative copy — keeping the dailies would
     * double-count every record in that month.
     */
    async function pruneCompactedDays(monthlyPaths: string[]): Promise<number> {
      if (!cacheStorageAvailable || monthlyPaths.length === 0) return 0;
      try {
        const compacted = new Set(
          monthlyPaths.map(monthKeyOfPath).filter((m): m is string => m !== null),
        );
        if (compacted.size === 0) return 0;

        const stale = (await cachedPaths()).filter((p) => {
          if (!isDailyPath(p)) return false;
          const mk = monthKeyOfPath(p);
          return mk !== null && compacted.has(mk);
        });
        if (stale.length === 0) return 0;

        const cache = await caches.open(CACHE_NAME);
        await Promise.all(stale.map((p) => cache.delete(contentsApiUrl(p))));
        return stale.length;
      } catch {
        return 0;
      }
    }

    function entryKey(e: HistoryEntry): string {
      return `${e.timestamp}|${e.status}|${e.latency ?? ""}`;
    }

    /**
     * Human label for a data path, e.g. "2026/08 monthly" or "2026/09/28 daily".
     * Kept separate from the URL so progress reads as a data file, not an API call.
     */
    function pathLabel(path: string): string {
      const rel = path.slice(path.lastIndexOf("data/uptime/") + "data/uptime/".length);
      const m = rel.match(/^(\d{4})\/(\d{2})\/(\d{2})\.jsonl$/);
      if (m) return `${m[1]}/${m[2]}/${m[3]} daily`;
      const mm = rel.match(/^(\d{4})\/(\d{2})\.jsonl$/);
      if (mm) return `${mm[1]}/${mm[2]} monthly`;
      return rel;
    }

    /** Strip the data dir so these helpers work on either full or relative paths. */
    function relDataPath(path: string): string {
      const i = path.indexOf(HISTORY_DATA_DIR);
      return i === -1 ? path : path.slice(i + HISTORY_DATA_DIR.length + 1);
    }

    /** Which calendar month a cache key belongs to, or null when unrecognised. */
    function monthKeyOfPath(path: string): string | null {
      const m = relDataPath(path).match(/^(\d{4})\/(\d{2})(?:\/\d{2})?\.jsonl$/);
      return m ? `${m[1]}/${m[2]}` : null;
    }

    function isDailyPath(path: string): boolean {
      return /^\d{4}\/\d{2}\/\d{2}\.jsonl$/.test(relDataPath(path));
    }

    function setProgress(done: number, total: number, label: string) {
      if (!progressEl) return;
      progressEl.hidden = false;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      if (progressFill) (progressFill as HTMLElement).style.width = `${pct}%`;
      if (progressText) {
        progressText.textContent = total > 0 ? `${done}/${total} · ${label}` : label;
      }
    }

    function hideProgress() {
      if (progressEl) progressEl.hidden = true;
      if (progressFill) (progressFill as HTMLElement).style.width = "0%";
      if (progressText) progressText.textContent = "";
    }

    /** Last observed rate-limit state, surfaced in the status line. */
    let rateLimit: { remaining: number; limit: number } | null = null;

    /**
     * Fetch a data file and cache its raw body. Returns the bytes so the caller
     * can filter for the current site; the cache never holds filtered data.
     */
    async function fetchFileText(path: string, token: string): Promise<string> {
      const headers: Record<string, string> = {
        // `.raw` returns the file body directly instead of base64 JSON, and
        // lifts the 1 MB inline-content limit.
        Accept: "application/vnd.github.v3.raw",
        "X-GitHub-Api-Version": "2022-11-28",
      };
      if (token) headers.Authorization = `Bearer ${token}`;

      const res = await fetch(contentsApiUrl(path), { headers });

      const remaining = res.headers.get("x-ratelimit-remaining");
      const limit = res.headers.get("x-ratelimit-limit");
      if (remaining !== null && limit !== null) {
        rateLimit = { remaining: Number(remaining), limit: Number(limit) };
      }

      // A month/day that never existed is "no data", not a failure.
      if (res.status === 404) return "";
      if (res.status === 403 || res.status === 429) {
        throw new Error("rate-limited");
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const text = await res.text();
      await cacheSetText(path, text);
      return text;
    }

    /**
     * Fold fetched history into the Checks History table and report what was
     * actually new. Entries already present in the built-in history (same
     * timestamp) are dropped rather than duplicated, and the merged list is
     * ordered by absolute instant so a December entry never sorts after the
     * following January.
     */
    function mergeIntoRecentChecks(entries: HistoryEntry[]): {
      added: number;
      duplicates: number;
    } {
      const tbody = document.getElementById("recent-checks-body");
      if (!tbody) return { added: 0, duplicates: 0 };

      const builtInIso = new Set<string>();
      tbody.querySelectorAll<HTMLTableRowElement>("tr[data-ts]").forEach((tr) => {
        const ts = tr.dataset.ts;
        if (ts) builtInIso.add(ts);
      });

      // Timestamps already rendered, so a re-load does not append duplicates.
      const seen = new Set(builtInIso);
      const merged = [...entries]
        .filter((e) => {
          if (seen.has(e.timestamp)) return false;
          seen.add(e.timestamp);
          return true;
        })
        .sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());

      if (merged.length === 0) return { added: 0, duplicates: entries.length };

      const frag = document.createDocumentFragment();
      for (const e of merged) {
        const tr = document.createElement("tr");
        tr.dataset.ts = e.timestamp;
        tr.dataset.source = "fetched";

        const tdTime = document.createElement("td");
        tdTime.className = "td-time";
        tdTime.textContent = fmtTime(e.timestamp);
        tr.appendChild(tdTime);

        const tdStatus = document.createElement("td");
        tdStatus.appendChild(createBadge(e.status));
        tr.appendChild(tdStatus);

        const tdLatency = document.createElement("td");
        tdLatency.className = "td-latency";
        tdLatency.textContent = fmtLatency(e.latency);
        tr.appendChild(tdLatency);

        // Mirrors the built-in rows' Source cell, which carries "Built".
        const tdSource = document.createElement("td");
        tdSource.className = "td-source";
        const tag = document.createElement("span");
        tag.className = "source-tag source-tag--fetched";
        tag.textContent = "Fetched";
        tag.title = "Loaded on demand by Extended History, not part of the built page.";
        tdSource.appendChild(tag);
        tr.appendChild(tdSource);

        frag.appendChild(tr);
      }
      tbody.appendChild(frag);

      // Built-in rows carry no marker; sort every row by its absolute instant.
      const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>("tr"));
      rows.sort((a, b) => {
        const ta = a.dataset.ts ? new Date(a.dataset.ts).getTime() : 0;
        const tb = b.dataset.ts ? new Date(b.dataset.ts).getTime() : 0;
        return tb - ta;
      });
      for (const tr of rows) tbody.appendChild(tr);

      return { added: merged.length, duplicates: entries.length - merged.length };
    }

    /**
     * `loaded` records came back for this site; only `added` of them were new
     * rows. The trigger badge reports the additions, the summary the split, so
     * "merged" never overstates what the table actually gained.
     */
    function render(entries: HistoryEntry[], loaded: number) {
      const { added, duplicates } = mergeIntoRecentChecks(entries);

      if (summaryEl) {
        const parts = [`${added} of ${loaded} records merged into Checks History`];
        if (duplicates > 0) parts.push(`${duplicates} already listed`);
        summaryEl.textContent = `${parts.join(" · ")} (${builtCount} built-in).`;
      }

      updateTrigger(added);
    }

    /**
     * Data files to load for the selected range. `monthsBack` is a count, or
     * `"all"` to walk back to the earliest month that has data.
     */
    function buildTargets(monthsBack: number | "all"): string[] {
      const now = new Date();
      const y = now.getFullYear();
      const m = now.getMonth() + 1; // 1-12

      const paths: string[] = [];
      // Whole past months are already merged into monthly JSONL files. "all"
      // runs back to EARLIEST_YEAR/MONTH instead of a fixed count; the
      // isWithinHistoryRange guard below stops it at that boundary either way.
      let back = 1;
      for (;;) {
        if (monthsBack !== "all" && back > monthsBack) break;
        const total = y * 12 + (m - 1) - back;
        const yy = Math.floor(total / 12);
        const mm = (total % 12) + 1;
        // Skip months before the earliest month that has any history data.
        if (!isWithinHistoryRange(yy, mm)) break;
        paths.push(monthlyFilePath(yy, mm));
        back++;
      }
      // Current month: daily files exist for every completed day (today is still raw).
      for (let day = 1; day < now.getDate(); day++) {
        paths.push(dailyFilePath(y, m, day));
      }
      return paths;
    }

    function saveToken(token: string) {
      try {
        if (token) localStorage.setItem(TOKEN_STORAGE_KEY, token);
        else localStorage.removeItem(TOKEN_STORAGE_KEY);
      } catch {
        // Storage disabled — the token simply will not persist.
      }
    }

    function loadSavedToken(): string {
      try {
        return localStorage.getItem(TOKEN_STORAGE_KEY) || "";
      } catch {
        return "";
      }
    }

    /**
     * Load the selected range. `auto` marks the cache-only pass done on page
     * entry: it must never hit the network, so cached files are used and
     * uncached ones are simply skipped.
     */
    async function load(opts: { auto?: boolean } = {}) {
      const auto = opts.auto === true;
      if (!loadBtn) return;
      loadBtn.disabled = true;
      setStatus("loading");

      const token = (tokenInput?.value || "").trim();
      saveToken(token);
      rateLimit = null;

      const rangeValue = monthsInput?.value || "6";
      const monthsBack = rangeValue === "all" ? "all" : Number(rangeValue) || 6;
      const targets = buildTargets(monthsBack);

      const merged = new Map<string, HistoryEntry>();
      let fetched = 0;
      let fromCache = 0;
      const failures: string[] = [];
      let rateLimited = false;
      const monthlySeen: string[] = [];

      setProgress(0, targets.length, auto ? "reading cache" : "starting");

      for (let i = 0; i < targets.length; i++) {
        const path = targets[i];
        const label = pathLabel(path);
        setProgress(i, targets.length, label);

        // The cache always holds the full file body, so the site filter runs
        // here, on the way out, for both cache hits and fresh fetches.
        let text = await cacheGetText(path);
        if (text !== null) {
          fromCache++;
        } else {
          // The cache-only pass on page entry never fetches.
          if (auto) {
            setProgress(i + 1, targets.length, label);
            continue;
          }
          try {
            text = await fetchFileText(path, token);
            fetched++;
          } catch (err) {
            const msg = err instanceof Error ? err.message : String(err);
            if (msg === "rate-limited") rateLimited = true;
            failures.push(path);
            // Once the API refuses, the remaining requests would fail too.
            if (rateLimited) break;
          }
        }

        if (text) {
          for (const e of parseJsonlForSite(text, siteId)) merged.set(entryKey(e), e);
        }

        if (!isDailyPath(path)) monthlySeen.push(path);
        // A monthly file that exists means its daily files are redundant.
        await pruneCompactedDays(monthlySeen);

        setProgress(i + 1, targets.length, label);
      }

      const entries = [...merged.values()];
      render(entries, entries.length);

      // Only an explicit load replaces the error wording; the cache-only pass
      // stays silent so page entry never reads like a failure.
      const parts: string[] = [`${entries.length} records`];
      if (fetched > 0) parts.push(`${fetched} files fetched`);
      if (fromCache > 0) parts.push(`${fromCache} from cache`);
      if (failures.length > 0) parts.push(`${failures.length} failed`);
      if (rateLimit) parts.push(`API quota ${rateLimit.remaining}/${rateLimit.limit}`);
      const detail = parts.join(" · ") + ".";

      if (entries.length === 0) {
        setStatus(auto || rateLimited ? "idle" : "empty", auto ? "" : detail);
      } else {
        setStatus(failures.length > 0 ? "error" : "done", detail);
      }
      if (rateLimited) {
        setStatus("error", `${detail} GitHub rate limit reached — add a token and retry.`);
      }

      if (clearBtn) clearBtn.disabled = false;
      loadBtn.disabled = false;
      // Keep the bar visible briefly so the final step is readable.
      window.setTimeout(hideProgress, auto ? 0 : 400);
      return entries.length;
    }

    /** Merge whatever is already cached into the page, without any network use. */
    async function autoLoadFromCache() {
      const paths = await cachedPaths();
      if (paths.length === 0) {
        setStatus("idle", "No cached history yet — open the dialog to load it.");
        return;
      }
      if (summaryEl) summaryEl.textContent = "Merging cached history…";
      await load({ auto: true });
    }

    async function clearCache() {
      let removed = 0;
      if (cacheStorageAvailable) {
        try {
          const cache = await caches.open(CACHE_NAME);
          removed = (await cache.keys()).length;
          await caches.delete(CACHE_NAME);
        } catch {
          // Ignore — nothing else to clean up.
        }
      }
      if (summaryEl) summaryEl.textContent = "";
      setStatus("idle", `Cleared ${removed} cached file(s).`);
      // The rows already merged into the table stay there, but nothing is
      // "loaded" any more — the trigger returns to its pre-load wording.
      updateTrigger(0);
    }

    // Restore a previously saved token.
    const savedToken = loadSavedToken();
    if (savedToken && tokenInput) tokenInput.value = savedToken;

    /**
     * Automatic merging is only for visitors who never fetched with a token.
     * Once a token is saved the cache can hold a year of records, and merging it
     * unasked would run on every page entry. With a token, history loads only
     * after an explicit **Load history** click.
     */
    const autoMergeEnabled = savedToken === "";

    loadBtn?.addEventListener("click", () => void load());
    clearBtn?.addEventListener("click", clearCache);
    openBtn?.addEventListener("click", () => {
      dialogEl?.showModal();
      // First open with an empty view: pull anything already cached.
      if (autoMergeEnabled && summaryEl && !summaryEl.textContent) void autoLoadFromCache();
    });
    closeBtn?.addEventListener("click", () => dialogEl?.close());
    // Click outside the panel (on the backdrop) closes the dialog.
    dialogEl?.addEventListener("click", (ev) => {
      if (ev.target === dialogEl) dialogEl.close();
    });

    // Purge pre-v2 buckets before anything reads the cache, so a stale bucket
    // can never be mistaken for current data. Runs on every page entry and is
    // cheap once the buckets are gone.
    void dropLegacyCaches().then(() => {
      // On page entry, load cached history without touching the network — but
      // only when no token is saved (see autoMergeEnabled above).
      if (autoMergeEnabled) void autoLoadFromCache();
    });
  })();
</script>

<style>
  .more-link { margin-top: 0.75rem; text-align: right; font-size: 0.8rem; }

  /* The trigger goes from a dashed "load" affordance to a solid "already
     merged" state, so the page reads as loaded after the dialog is closed. */
  #history-open[data-state="merged"] {
    color: var(--color-text);
    border-color: var(--color-up);
    border-style: solid;
  }

  .more-badge {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.35rem;
    border-radius: 999px;
    background: var(--color-up);
    color: #fff;
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .more-badge[hidden] { display: none; }

  .btn {
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
    font-family: inherit;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    transition: opacity 0.15s, background 0.15s;
  }

  .btn:hover:not(:disabled) { background: var(--color-border); }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn--primary {
    background: var(--color-link);
    border-color: var(--color-link);
    color: #fff;
  }

  .btn--primary:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-link) 85%, #000);
  }

  .btn--ghost {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    padding: 0.3rem 0.7rem;
  }

  .btn--ghost:hover {
    color: var(--color-text);
    border-color: var(--color-text-secondary);
  }

  .history-dialog {
    /* The global `* { margin: 0 }` reset in Layout.astro also clears the UA's
       `margin: auto`, which is what centers a modal <dialog> in the top layer.
       Restore it explicitly, otherwise the dialog pins to the top-left. */
    margin: auto;
    width: min(60rem, calc(100vw - 2rem));
    max-height: calc(100vh - 4rem);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    color: var(--color-text);
    padding: 1.25rem;
    overflow: auto;
  }

  .history-dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  .history-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .history-dialog-head h2 { margin-bottom: 0; }

  .history-progress { margin-top: 0.5rem; }

  .history-progress-bar {
    height: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-text-secondary) 25%, transparent);
    overflow: hidden;
  }

  .history-progress-bar > span {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: var(--color-accent, var(--color-up));
    transition: width 0.15s ease-out;
  }

  .history-progress-text {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-top: 0.3rem;
    font-variant-numeric: tabular-nums;
  }

  .history-panel {
    background: var(--color-surface);
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    padding: 1rem;
  }

  .history-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .field { display: flex; flex-direction: column; gap: 0.25rem; }

  .field--wide { flex: 1; min-width: 200px; }

  .field-label {
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .field-input {
    appearance: none;
    -webkit-appearance: none;
    padding: 0.4rem 0.6rem;
    font-size: 0.85rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    outline: none;
    font-family: inherit;
  }

  .field-input:focus {
    border-color: var(--color-link);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-link) 20%, transparent);
  }

  .history-actions { display: flex; gap: 0.5rem; }

  .history-note {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-top: 0.75rem;
    line-height: 1.5;
  }

  .history-status {
    font-size: 0.8rem;
    margin-top: 0.5rem;
    min-height: 1.2em;
  }

  .history-status[data-kind="done"] { color: var(--color-up); }
  .history-status[data-kind="empty"] { color: var(--color-text-secondary); }
  .history-status[data-kind="error"] { color: var(--color-down); }
  .history-status[data-kind="loading"] { color: var(--color-text-secondary); }
  .history-status[data-kind="idle"] { color: var(--color-text-secondary); }

  .history-summary {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-top: 0.25rem;
  }

  /*
   * This component renders no table of its own: fetched records are merged into
   * the page's Checks History table, which owns the styling for those rows —
   * including the :global(...) copies that runtime-created rows need, since
   * they never carry Astro's scoping attribute.
   */
</style>
