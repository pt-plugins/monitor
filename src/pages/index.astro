---
import Layout from "../components/Layout.astro";
import SiteCard from "../components/SiteCard.astro";
import CheckHeatmap from "../components/CheckHeatmap.astro";
import { computeDailyCheckCounts, computeSiteSummaries, getLatestTimestamp } from "../lib/data-loader";
import { DISPLAY_TIME_ZONE_LABEL, formatCheckTime } from "../lib/history-fetch";

const summaries = computeSiteSummaries();
const latestTimestamp = getLatestTimestamp();
const checkCounts = computeDailyCheckCounts();

const total = summaries.length;
const upCount = summaries.filter((s) => s.currentStatus === "up").length;
const downCount = summaries.filter((s) => s.currentStatus === "down").length;
const deadCount = summaries.filter((s) => s.currentStatus === "dead").length;
const overallUptime = total > 0 ? Math.round((upCount / (total - deadCount)) * 100) || 100 : 100;
const activeSites = summaries.filter((s) => s.currentStatus !== "dead");
const deadSites = summaries.filter((s) => s.currentStatus === "dead");

function formatTime(iso: string | null): string {
  // Rendered in the fixed zone every other check timestamp on the site uses
  // (see history-fetch). Formatting in the runtime's own zone made this line
  // read GMT+8 off a build machine in Asia/Shanghai and UTC in CI.
  return iso ? formatCheckTime(iso) : "N/A";
}
---

<Layout title="Dashboard">
  {/* The summary block and the check heatmap are one panel: "how are the
      checks doing" is a single question, answered by the current numbers and
      the shape of the recent activity together. */}
  <section class="section">
    <div class="section-head">
      <h2 class="section-title">Checks Status</h2>
      <p class="updated">
        Last updated: <time datetime={latestTimestamp ?? ""}>{formatTime(latestTimestamp)}</time>
        {latestTimestamp && <span class="updated-zone">({DISPLAY_TIME_ZONE_LABEL})</span>}
      </p>
    </div>

    <div class="checks-panel">
      <div class="stats-bar">
        <div class="stat-item stat-item--total">
          <span class="stat-number">{total}</span>
          <span class="stat-label">Sites</span>
        </div>
        <div class="stat-item stat-item--up">
          <span class="stat-number">{upCount}</span>
          <span class="stat-label">Up</span>
        </div>
        <div class="stat-item stat-item--down">
          <span class="stat-number">{downCount}</span>
          <span class="stat-label">Down</span>
        </div>
        <div class="stat-item stat-item--dead">
          <span class="stat-number">{deadCount}</span>
          <span class="stat-label">Dead</span>
        </div>
        <div class="stat-item stat-item--uptime">
          <span class="stat-number">{overallUptime}%</span>
          <span class="stat-label">Uptime</span>
        </div>
      </div>

      {checkCounts.length > 0 && <CheckHeatmap days={checkCounts} />}
    </div>
  </section>

  {
    summaries.length === 0 ? (
      <div class="empty-state">
        <p>No site data available yet. Run monitoring to populate data.</p>
      </div>
    ) : (
      <>
        <section class="section">
          <h2 class="section-title">Active Sites</h2>
          {activeSites.length > 0 ? (
            <div class="site-grid">
              {activeSites.map((site) => <SiteCard site={site} />)}
            </div>
          ) : (
            <p class="empty">No active sites.</p>
          )}
        </section>
        {deadSites.length > 0 && (
          <section class="section">
            <h2 class="section-title section-title--dead">Dead Sites</h2>
            <div class="site-grid">
              {deadSites.map((site) => <SiteCard site={site} />)}
            </div>
          </section>
        )}
      </>
    )
  }
</Layout>

<style>
  /* Heading row: the section title and the "last updated" stamp share one rule,
     so the stamp belongs to the block it dates rather than floating above it. */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.35rem;
    margin-bottom: 0.75rem;
  }

  .section-head .section-title {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .updated {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  /* Names the zone the timestamp is in, as the Checks History column header
     does — the value alone cannot say which zone it is. */
  .updated-zone { opacity: 0.75; }

  /* The two blocks keep their natural size and are centred as a pair, with the
     spare width left on both sides. Growing them only produced wide, empty
     tiles, and pushing them to the edges opened a hole between them. */
  .checks-panel {
    display: flex;
    flex-wrap: wrap;
    /* Stretch, not flex-start: side by side, the two blocks then share one
       bottom edge instead of a ragged step. A wrapped line holds a single item,
       whose height is its own, so this only affects that row. */
    align-items: stretch;
    justify-content: center;
    gap: 1.5rem;
  }

  /* Two tiles to a line in the sidebar, five when the counters own a wide line
     — never three or four: four counters do not divide evenly into those, and
     the leftover tile leaves a hole. Thresholds are rem so they track the
     reader's font size, which is what the tiles scale with. */
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    width: 17.5rem;
    flex: 0 0 auto;
  }

  /* Uptime closes the block as a full-width summary tile. */
  .stat-item--uptime {
    grid-column: 1 / -1;
  }

  /* Stacked panel: the counters own the whole line. */
  @media (max-width: 55rem) {
    .stats-bar { width: 100%; }
  }

  /* Five even tiles fit, so Uptime takes its place in the row rather than
     stretching into a banner the width of the card. */
  @media (min-width: 36rem) and (max-width: 55rem) {
    .stats-bar { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .stat-item--uptime { grid-column: auto; }
  }

  .stat-item {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 0.55rem 1rem;
    box-shadow: var(--shadow);
    border: 1px solid var(--color-border);
    text-align: center;
    min-width: 0;
    /* The tile's own line box would otherwise be set by the body's 1.6 strut,
       adding ~10px under a label that is already single-line. */
    line-height: 1.1;
  }

  .stat-number {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.7rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-item--total .stat-number { color: var(--color-link); }
  .stat-item--up .stat-number { color: var(--color-up); }
  .stat-item--down .stat-number { color: var(--color-down); }
  .stat-item--dead .stat-number { color: var(--color-dead); }
  .stat-item--uptime .stat-number { color: var(--color-up); }

  .site-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--color-text-secondary);
  }

  .section {
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-title--dead {
    color: var(--color-dead);
  }

  .empty {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }
</style>
