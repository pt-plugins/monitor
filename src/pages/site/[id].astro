---
import Layout from "../../components/Layout.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import LatencyChart from "../../components/LatencyChart.astro";
import SiteUptimeHeatmap from "../../components/SiteUptimeHeatmap.astro";
import ExtendedHistory from "../../components/ExtendedHistory.astro";
import { computeSiteDailyUptime, computeSiteSummaries } from "../../lib/data-loader";
import { DISPLAY_TIME_ZONE_LABEL, formatCheckTime } from "../../lib/history-fetch";

export function getStaticPaths() {
  const summaries = computeSiteSummaries();
  return summaries.map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
const summaries = computeSiteSummaries();
const site = summaries.find((s) => s.id === id);

if (!site) {
  return Astro.redirect("/");
}

const isDead = site.currentStatus === "dead";

/*
 * The heatmap's series comes from the whole record, not from `site.history`:
 * the page embeds only the newest 336 checks — with the monitor's real cadence
 * that is well under three months — while the grid draws whole weeks back.
 */
const siteDailyUptime = computeSiteDailyUptime(site.id);

function fmtLatency(ms: number | null): string {
  if (ms === null) return "—";
  if (ms < 1000) return `${ms}ms`;
  return `${(ms / 1000).toFixed(1)}s`;
}

function fmtTime(iso: string): string {
  // Rendered in a fixed zone shared with the browser-side merge; formatting in
  // the build machine's zone made the two disagree on a visitor in another zone.
  return formatCheckTime(iso);
}

function uptimeColor(pct: number): string {
  if (isDead) return "var(--color-dead)";
  if (pct >= 99) return "var(--color-up)";
  if (pct >= 95) return "var(--color-warn)";
  return "var(--color-down)";
}

function fmtUptime(pct: number): string {
  if (isDead) return "—";
  return `${pct}%`;
}

// Built-in history shown in the table (last 50 entries, reversed for the table)
const recentHistory = [...site.history].reverse().slice(0, 50);

/*
 * Certificate and domain expiry.
 *
 * The snapshot is written every few days (scripts/certificates.mjs) while the
 * page is rebuilt every two hours, so nothing that can be derived is stored:
 * the days remaining are worked out at build time from the stored expiry date,
 * and re-rendered at every build from then on.
 */
type CertTone = "ok" | "warn" | "bad" | "unknown";

interface CertRow {
  title: string;
  source: string | null;
  sourceLabel: string;
  status: string;
  tone: CertTone;
  /** Expiry date, YYYY-MM-DD; null when there is nothing to show. */
  expires: string | null;
  remaining: string | null;
  /**
   * When this date was read, YYYY-MM-DD. The run is incremental, so a value far
   * from expiry is carried over rather than measured again, and this can be
   * much older than the snapshot it sits in.
   */
  checked: string | null;
  /** A caveat that does not change the expiry itself, such as an untrusted chain. */
  note: string | null;
}

function fmtRemaining(days: number | null): string | null {
  if (days === null) return null;
  if (days < 0) return `expired ${Math.abs(days)} day${days === -1 ? "" : "s"} ago`;
  if (days === 0) return "expires today";
  return `${days} day${days === 1 ? "" : "s"} left`;
}

function certRow(opts: {
  title: string;
  source: string | null;
  sourceLabel: string;
  expiresAt: string | null;
  daysRemaining: number | null;
  checkedAt: string | null;
  /** Days left at which the row starts warning. */
  warnDays: number;
  error: string | null;
  trustError?: string | null;
}): CertRow {
  const base: CertRow = {
    title: opts.title,
    source: null,
    sourceLabel: opts.sourceLabel,
    tone: "unknown",
    status: "Unavailable",
    expires: null,
    remaining: null,
    // ISO instant, and the page renders every timestamp in UTC, so the date
    // part of it is the date to show.
    checked: opts.checkedAt ? opts.checkedAt.slice(0, 10) : null,
    note: opts.error,
  };

  // Nothing was read: the row states why rather than showing a date it does not
  // have, which is what "Unavailable" next to an empty value would imply.
  if (opts.error || !opts.expiresAt) return base;

  const days = opts.daysRemaining;
  const tone: CertTone = days === null ? "unknown" : days < 0 ? "bad" : days <= opts.warnDays ? "warn" : "ok";
  const status = tone === "ok" ? "Valid" : tone === "warn" ? "Expiring soon" : tone === "bad" ? "Expired" : "Unknown";

  return {
    ...base,
    source: opts.source,
    tone,
    status,
    expires: opts.expiresAt.slice(0, 10),
    remaining: fmtRemaining(days),
    note: opts.trustError ? `Chain not trusted: ${opts.trustError}` : null,
  };
}

const certRows: CertRow[] | null = site.certificate
  ? [
      certRow({
        title: "SSL Certificate",
        source: site.certificate.ssl.issuer,
        sourceLabel: "Issuer",
        expiresAt: site.certificate.ssl.notAfter,
        daysRemaining: site.certificate.ssl.daysRemaining,
        checkedAt: site.certificate.ssl.checkedAt,
        // A certificate is usually renewed well before it lapses, so only the
        // last fortnight is worth flagging.
        warnDays: 14,
        error: site.certificate.ssl.error,
        trustError: site.certificate.ssl.trustError,
      }),
      certRow({
        title: "Domain Registration",
        source: site.certificate.domain.registrar,
        sourceLabel: "Registrar",
        expiresAt: site.certificate.domain.expiresAt,
        daysRemaining: site.certificate.domain.daysRemaining,
        checkedAt: site.certificate.domain.checkedAt,
        // A lapsed registration is not renewed automatically and takes the site
        // with it, so a month's notice is the useful warning.
        warnDays: 30,
        error: site.certificate.domain.error,
      }),
    ]
  : null;

const certEmptyNote = isDead
  ? "Not checked — this site is marked dead and is no longer monitored."
  : "Not checked yet — certificates and domain registrations are checked every few days.";
---

<Layout title={site.name} showFilter={false}>
  <div class="detail-header">
    <div class="detail-title">
      <h1>
        {site.faviconUrl && (
          <img class="card-favicon" src={site.faviconUrl} alt="" width="16" height="16" loading="lazy" onerror="this.style.display='none'" />
        )}
        {site.name}
      </h1>
      <StatusBadge status={site.currentStatus} />
      <div class="detail-links">
        {site.primaryUrl && (
          <a
            class="source-link"
            href={site.primaryUrl}
            target="_blank"
            rel="noopener"
            title={site.primaryUrl}
          >
            <img src="/monitor/icons/web.svg" alt="Site URL" width="18" height="18" />
          </a>
        )}
        <a
          class="source-link"
          href={`https://github.com/pt-plugins/PT-depiler/tree/master/src/packages/site/definitions/${site.id}.ts`}
          target="_blank"
          rel="noopener"
          title="View source in PT-depiler"
        >
          <img src="/monitor/icons/github.svg" alt="GitHub" width="18" height="18" />
        </a>
      </div>
    </div>
    {site.description && <p class="detail-description">{site.description}</p>}
  </div>

  <!-- Uptime Summary -->
  <section class="section">
    <h2>Uptime</h2>
    <div class="uptime-grid">
      <div class="uptime-card">
        <div class="uptime-value" style={`color: ${uptimeColor(site.uptime24h)}`}>{fmtUptime(site.uptime24h)}</div>
        <div class="uptime-label">24 hours</div>
      </div>
      <div class="uptime-card">
        <div class="uptime-value" style={`color: ${uptimeColor(site.uptime7d)}`}>{fmtUptime(site.uptime7d)}</div>
        <div class="uptime-label">7 days</div>
      </div>
      <div class="uptime-card">
        <div class="uptime-value" style={`color: ${uptimeColor(site.uptime30d)}`}>{fmtUptime(site.uptime30d)}</div>
        <div class="uptime-label">30 days</div>
      </div>
      <div class="uptime-card">
        <div class="uptime-value">{fmtLatency(site.currentLatency)}</div>
        <div class="uptime-label">Current Latency</div>
      </div>
      {/*
        Every latency figure covers the same 7 days the chart below draws — the
        mean alone hid the slow tail, which is what a percentile is for. All of
        them describe the checks that answered: a failed check has no latency to
        average, so the outage side of the window is the uptime cards above.
      */}
      <div class="uptime-card">
        <div class="uptime-value">{fmtLatency(site.latency7d.avg)}</div>
        <div class="uptime-label">Avg Latency (7d)</div>
      </div>
      <div class="uptime-card">
        <div class="uptime-value">{fmtLatency(site.latency7d.p90)}</div>
        <div class="uptime-label">P90 Latency (7d)</div>
      </div>
      <div class="uptime-card">
        <div class="uptime-value">{fmtLatency(site.latency7d.p95)}</div>
        <div class="uptime-label">P95 Latency (7d)</div>
      </div>
      <div class="uptime-card">
        <div class="uptime-value">{fmtLatency(site.latency7d.p99)}</div>
        <div class="uptime-label">P99 Latency (7d)</div>
      </div>
    </div>
  </section>

  <!-- Latency Chart -->
  <section class="section">
    <h2>Response Time (7 days)</h2>
    <LatencyChart data={site.history} />
  </section>

  <!-- Daily Uptime -->
  {siteDailyUptime.length > 0 && (
    <section class="section">
      <h2>Daily Uptime</h2>
      <SiteUptimeHeatmap days={siteDailyUptime} />
    </section>
  )}

  <!-- Certificate & Domain -->
  <section class="section">
    <div class="section-head">
      <h2>Certificate &amp; Domain</h2>
      {site.certificate && (
        <span class="section-stamp">Updated {fmtTime(site.certificate.updatedAt)} ({DISPLAY_TIME_ZONE_LABEL})</span>
      )}
    </div>
    {certRows ? (
      <div class="cert-grid">
        {certRows.map((row) => (
          <div class="cert-card" data-tone={row.tone}>
            <div class="cert-head">
              <span class="cert-title">{row.title}</span>
              <span class="cert-pill">{row.status}</span>
            </div>
            {row.expires ? (
              <>
                <div class="cert-value">{row.expires}</div>
                <div class="cert-remaining">{row.remaining}</div>
              </>
            ) : (
              <p class="cert-error">{row.note}</p>
            )}
            {(row.source || row.checked) && (
              <dl class="cert-facts">
                {row.source && (
                  <div>
                    <dt>{row.sourceLabel}</dt>
                    <dd>{row.source}</dd>
                  </div>
                )}
                {/* The run carries a value over while it is far from expiry, so
                    the date it was read is part of reading this card. */}
                {row.checked && (
                  <div>
                    <dt>Checked</dt>
                    <dd>{row.checked}</dd>
                  </div>
                )}
              </dl>
            )}
            {row.expires && row.note && <p class="cert-note">{row.note}</p>}
          </div>
        ))}
      </div>
    ) : (
      <p class="empty">{certEmptyNote}</p>
    )}
  </section>

  <!-- Checks History -->
  <section class="section">
    <div class="section-head">
      <h2>Checks History</h2>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Time <span class="th-note">({DISPLAY_TIME_ZONE_LABEL})</span></th>
            <th>Status</th>
            <th>Latency</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody id="recent-checks-body">
          {recentHistory.map((entry) => (
            <tr data-ts={entry.timestamp}>
              <td class="td-time">{fmtTime(entry.timestamp)}</td>
              <td><StatusBadge status={entry.status} size="sm" /></td>
              <td class="td-latency">{fmtLatency(entry.latency)}</td>
              <td class="td-source"><span class="source-tag source-tag--builtin">Built</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      {recentHistory.length === 0 && <p class="empty">No monitoring data yet.</p>}
    </div>
    <ExtendedHistory siteId={site.id} builtCount={site.history.length} />
  </section>
</Layout>

<style>
  .detail-header { margin-bottom: 1.5rem; }

  .detail-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .detail-title h1 { margin-bottom: 0; }

  /* The description sits between the name row and the Uptime section: muted so
     it reads as context for the numbers below rather than a heading of its
     own. */
  .detail-description {
    margin: 0.5rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 80ch;
  }

  /* The icon and the name are two inline boxes in the same heading, and Astro
     trims the whitespace between them, so the gap has to come from the image.
     em keeps it proportional to the heading, like the gap on the site cards. */
  .card-favicon { margin-right: 0.4em; }

  /* The icon links sit together at the far end of the row. The auto margin
     belongs to this wrapper, not to each link: on two links the free space
     would split between them and push the pair apart. */
  .detail-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .source-link {
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    opacity: 0.6;
    transition: opacity 0.15s;
  }

  .source-link:hover { opacity: 1; color: var(--color-text); }

  .section { margin-bottom: 2rem; }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-head h2 { margin-bottom: 0; }

  :global(#recent-checks-body tr:hover) { background: color-mix(in srgb, var(--color-text-secondary) 8%, transparent); }

  .section h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .uptime-grid { display: flex; gap: 1rem; flex-wrap: wrap; }

  .uptime-card {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow);
    border: 1px solid var(--color-border);
    text-align: center;
    min-width: 100px;
  }

  .uptime-value {
    font-size: 1.5rem; font-weight: 700;
    font-variant-numeric: tabular-nums; line-height: 1.2;
  }

  .uptime-label {
    font-size: 0.7rem; color: var(--color-text-secondary);
    text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0.2rem;
  }

  /*
   * Certificate & Domain. Two cards stating one expiry date each. The state is
   * written into the pill as well as tinted, so a certificate that is about to
   * lapse is legible without relying on the colour.
   */
  .section-stamp {
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .cert-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1rem 1.25rem;
  }

  .cert-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .cert-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }

  .cert-pill {
    flex-shrink: 0;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15em 0.6em;
    border-radius: 999px;
  }

  .cert-card[data-tone="ok"] .cert-pill {
    color: var(--color-up);
    background: color-mix(in srgb, var(--color-up) 15%, transparent);
  }

  .cert-card[data-tone="warn"] .cert-pill {
    color: var(--color-warn);
    background: color-mix(in srgb, var(--color-warn) 18%, transparent);
  }

  .cert-card[data-tone="bad"] .cert-pill {
    color: var(--color-down);
    background: color-mix(in srgb, var(--color-down) 15%, transparent);
  }

  .cert-card[data-tone="unknown"] .cert-pill {
    color: var(--color-text-secondary);
    background: var(--color-bg);
  }

  .cert-value {
    font-size: 1.35rem; font-weight: 700;
    font-variant-numeric: tabular-nums; line-height: 1.2;
  }

  .cert-remaining { font-size: 0.75rem; color: var(--color-text-secondary); }

  .cert-facts {
    display: grid;
    gap: 0.2rem;
    margin: 0.6rem 0 0;
    font-size: 0.75rem;
  }

  /* A fixed label column so the value starts at the same place in both rows. */
  .cert-facts div { display: flex; gap: 0.5rem; }
  .cert-facts dt { flex: 0 0 4.5rem; color: var(--color-text-secondary); }
  .cert-facts dd { margin: 0; overflow-wrap: anywhere; }

  .cert-note { margin: 0.5rem 0 0; font-size: 0.72rem; color: var(--color-warn); }
  .cert-error { margin: 0; font-size: 0.78rem; color: var(--color-text-secondary); }

  .table-wrap {
    background: var(--color-surface);
    border-radius: var(--radius); border: 1px solid var(--color-border);
    overflow: hidden; max-height: 400px; overflow-y: auto;
  }

  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }

  th {
    text-align: left; padding: 0.5rem 0.75rem;
    background: var(--color-bg); font-size: 0.7rem;
    color: var(--color-text-secondary); text-transform: uppercase;
    letter-spacing: 0.04em; position: sticky; top: 0;
  }

  /* The zone suffix is a qualifier on the column, not a second label, so it
     stays in the header's muted colour at a slightly smaller size. */
  .th-note { font-weight: 400; opacity: 0.75; text-transform: none; }

  /*
   * Rows merged in by ExtendedHistory are created at runtime, so they carry no
   * Astro scoping attribute and cannot be reached by the scoped rules above.
   * These global copies (keyed to this table) keep merged and built-in rows
   * looking identical.
   */
  :global(#recent-checks-body td) { padding: 0.4rem 0.75rem; border-top: 1px solid var(--color-border); }

  :global(.td-time) {
    font-variant-numeric: tabular-nums; white-space: nowrap;
    color: var(--color-text-secondary); font-size: 0.8rem;
  }

  :global(.td-latency) { font-variant-numeric: tabular-nums; white-space: nowrap; }

  :global(.td-source) { white-space: nowrap; }

  /*
   * Source tag: distinguishes records fetched on demand by Extended History
   * from the ones the build embedded. Built-in rows get their tag in the
   * template; merged rows are created at runtime, so every rule they need is
   * global.
   */
  :global(.source-tag) {
    display: inline-block;
    padding: 0.05em 0.45em;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border: 1px solid transparent;
  }

  :global(.source-tag--builtin) {
    color: var(--color-text-secondary);
    border-color: var(--color-border);
    background: var(--color-bg);
  }

  :global(.source-tag--fetched) {
    color: var(--color-link);
    border-color: color-mix(in srgb, var(--color-link) 40%, transparent);
    background: color-mix(in srgb, var(--color-link) 10%, transparent);
  }

  /* A fetched row also carries a tint and a leading accent, so the two kinds of
     row are told apart at a glance and not only by reading the tag. */
  :global(#recent-checks-body tr[data-source="fetched"]) {
    background: color-mix(in srgb, var(--color-link) 5%, transparent);
  }

  :global(#recent-checks-body tr[data-source="fetched"] td:first-child) {
    box-shadow: inset 2px 0 0 var(--color-link);
  }

  .empty { text-align: center; padding: 1rem; color: var(--color-text-secondary); font-size: 0.85rem; }

  /*
   * Rows fetched by ExtendedHistory are appended to this table at runtime, so
   * they never carry Astro's scoping attribute and StatusBadge.astro's scoped
   * rules cannot reach them. These global copies mirror that component exactly
   * so merged rows render identically to the server-rendered ones.
   */
  :global(.badge) {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-weight: 600;
    border-radius: 999px;
    padding: 0.15em 0.65em;
    white-space: nowrap;
  }

  :global(.badge--sm) {
    font-size: 0.7rem;
    padding: 0.1em 0.5em;
  }

  :global(.badge-dot) {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  :global(.badge--up) { background: color-mix(in srgb, var(--color-up) 15%, transparent); color: var(--color-up); }
  :global(.badge--up .badge-dot) { background: var(--color-up); }

  :global(.badge--down) { background: color-mix(in srgb, var(--color-down) 15%, transparent); color: var(--color-down); }
  :global(.badge--down .badge-dot) { background: var(--color-down); }

  :global(.badge--dead) { background: color-mix(in srgb, var(--color-dead) 15%, transparent); color: var(--color-dead); }
  :global(.badge--dead .badge-dot) { background: var(--color-dead); }

  :global(.badge--blocked) { background: color-mix(in srgb, var(--color-text-secondary) 15%, transparent); color: var(--color-text-secondary); }
  :global(.badge--blocked .badge-dot) { background: var(--color-text-secondary); }

</style>
